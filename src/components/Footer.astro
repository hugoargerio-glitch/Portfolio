---
import { cltConfig, freelaConfig, navItems, siteConfig } from "../config";
---

<footer class="relative bg-gray-50/75 dark:bg-[#0B0F17]/75 border-t border-gray-200 dark:border-slate-800 transition-colors duration-300">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-8"
    >
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-2xl font-bold text-gray-800 dark:text-slate-100">
            {siteConfig.name}
          </h3>
          <p class="mode-clt text-base text-gray-600 dark:text-slate-300 mt-1">
            {cltConfig.title}
          </p>
          <p class="mode-freela text-base text-gray-600 dark:text-slate-300 mt-1">
            {freelaConfig.title}
          </p>
        </div>

        <!-- CTA de conversão por modo -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href={cltConfig.cta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mode-clt inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
            style="background-color: var(--clt-accent)"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
              <path d="M7 11l5 5l5 -5"></path>
              <path d="M12 4l0 12"></path>
            </svg>
            {cltConfig.cta.label}
          </a>

          <a
            href={freelaConfig.cta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mode-freela inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
            style="background-color: var(--freela-accent)"
          >
            {freelaConfig.cta.label}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M7 17l10 -10"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>

          {
            freelaConfig.cta.secondaryHref &&
              freelaConfig.cta.secondaryLabel && (
                <a
                  href={freelaConfig.cta.secondaryHref}
                  class="mode-freela inline-flex items-center px-4 py-2.5 rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-[#111827]/90 text-sm font-medium text-gray-700 dark:text-slate-200 hover:border-gray-400 dark:hover:border-[var(--accent-color)] hover:text-gray-900 dark:hover:text-slate-100 transition-colors"
                >
                  {freelaConfig.cta.secondaryLabel}
                </a>
              )
          }
        </div>

        <div class="flex gap-x-6 pt-1">
          {
            siteConfig.social?.email && (
              <a
                href={`mailto:${siteConfig.social.email}`}
                aria-label="Email"
                class="text-gray-600 dark:text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="text-gray-600 dark:text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M8 11v5" />
                  <path d="M8 8v.01" />
                  <path d="M12 16v-5" />
                  <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.whatsapp && (
              <a
                href={siteConfig.social.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
                class="text-gray-600 dark:text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
                  <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.twitter && (
              <a
                href={siteConfig.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Twitter"
                class="text-gray-600 dark:text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                  <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
                </svg>
              </a>
            )
          }
          {
            siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="text-gray-600 dark:text-slate-400 transition-colors duration-300 hover:text-[var(--accent-color)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                </svg>
              </a>
            )
          }
        </div>
      </div>

      <div class="flex flex-col md:items-end gap-4">
        <nav
          aria-label="Navegação do rodapé"
          class="hidden md:flex flex-wrap justify-end gap-x-5 lg:gap-x-7 gap-y-2"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`${item.modeClass ?? ""} whitespace-nowrap text-sm text-gray-600 hover:text-gray-800 dark:text-slate-400 dark:hover:text-slate-100 transition-colors`.trim()}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        {
          freelaConfig.resumeUrl && (
            <a
              href={freelaConfig.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mode-freela text-xs text-gray-500 dark:text-slate-400 underline underline-offset-4 hover:text-gray-800 dark:hover:text-slate-200 transition-colors"
            >
              Currículo técnico (PDF)
            </a>
          )
        }

        <p class="text-sm text-gray-500 dark:text-slate-400">
          © {new Date().getFullYear()} {siteConfig.name}. Todos os direitos
          reservados.
        </p>
      </div>
    </div>
  </div>

  <!-- Decorative pattern -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg
      aria-hidden="true"
      class="absolute bottom-0 left-0 w-full h-24 text-gray-100 dark:text-slate-800/60"
    >
      <pattern
        id="footer-pattern"
        x="0"
        y="0"
        width="100"
        height="100"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M0 50 Q 25 40, 50 50 T 100 50"
          stroke="currentColor"
          stroke-width="0.5"
          fill="none"
          opacity="0.4"></path>
      </pattern>
      <rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
    </svg>
  </div>
</footer>
