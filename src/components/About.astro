---
import { withBase } from "../config";
import { profileBilingualEntries } from "../i18n/configs";
import { getTechIconByKey } from "../utils/techIcons";
import BiText from "./BiText.astro";
import TechBadge from "./TechBadge.astro";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    {/* Cabeçalho da seção acima do grid de 2 colunas para alinhamento simétrico */}
    <div class="mb-8 lg:mb-10">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl lg:text-3xl xl:text-4xl 2xl:text-5xl font-bold text-gray-900 dark:text-slate-100"
      >
        <span class="mode-clt"><BiText pt="Sobre Mim" en="About Me" /></span>
        <span class="mode-freela"><BiText pt="Proposta de Valor" en="Value Proposition" /></span>
      </h2>
      <div
        class="w-[75px] h-[5px] mt-2 rounded-full transition-colors duration-300"
        style="background-color: var(--accent-color)"
      >
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
      {/* Coluna Esquerda: Card Glass Luminoso da Foto + Barra de Status */}
      <div class="lg:col-span-4 flex">
        <div
          class="profile-glow-card relative w-full max-w-[300px] sm:max-w-xs lg:max-w-none flex flex-col justify-between bg-white/90 dark:bg-slate-900/70 backdrop-blur-sm p-3 rounded-2xl border transition-all duration-500"
        >
          {/* Pontos de luz decorativos nos cantos superiores */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute top-5 left-5 right-5 z-10 flex items-center justify-between"
          >
            <span class="corner-glow-dot h-2 w-2 rounded-full transition-all duration-500" />
            <span class="corner-glow-dot h-2 w-2 rounded-full transition-all duration-500" />
          </div>

          <div class="relative flex-1 min-h-[260px] lg:min-h-[300px] aspect-square lg:aspect-auto overflow-hidden rounded-xl border border-slate-200/90 dark:border-slate-800 bg-slate-100 dark:bg-slate-950">
            <img
              src={withBase("hugo-profile.jpeg")}
              alt="Hugo Argeri Campos"
              loading="lazy"
              decoding="async"
              onerror="this.classList.add('hidden'); this.nextElementSibling?.classList.remove('hidden');"
              class="w-full h-full object-cover object-[50%_22%]"
            />
            <div
              class="hidden absolute inset-0 flex flex-col items-center justify-center gap-2 bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-300 font-mono"
              aria-hidden="true"
            >
              <span
                class="flex h-14 w-14 items-center justify-center rounded-full border text-lg font-bold"
                style="color: var(--accent-color); border-color: color-mix(in srgb, var(--accent-color) 40%, transparent); background-color: color-mix(in srgb, var(--accent-color) 10%, transparent);"
              >
                HC
              </span>
              <span class="text-xs">Hugo Argeri Campos</span>
            </div>
          </div>

          {/* Barra de status compacta por modo */}
          <div class="shrink-0 mt-3 pt-3 border-t border-slate-200/80 dark:border-slate-800/90 font-mono">
            <div class="mode-clt space-y-1">
              <div class="flex items-center gap-2 text-xs font-semibold text-gray-900 dark:text-slate-100 leading-snug">
                <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500" />
                </span>
                <span>
                  <BiText
                    pt="Aberto a posições Data Engineer / Python"
                    en="Open to Data Engineer / Python Roles"
                  />
                </span>
              </div>
              <p class="text-[11px] text-gray-500 dark:text-slate-400 pl-4">
                <BiText pt="Brasil • Remoto" en="Brazil (UTC-3) • Global Remote" />
              </p>
            </div>

            <div class="mode-freela space-y-1">
              <div class="flex items-center gap-2 text-xs font-semibold text-gray-900 dark:text-slate-100 leading-snug">
                <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500" />
                </span>
                <span>
                  <BiText
                    pt="Consultoria B2B & Automação de Dados"
                    en="B2B Consulting & Data Automation"
                  />
                </span>
              </div>
              <p class="text-[11px] text-gray-500 dark:text-slate-400 pl-4">
                <BiText
                  pt="Diagnóstico Técnico Gratuito"
                  en="Free Technical Diagnostic"
                />
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* Coluna Direita: Texto + Badges / Cards alinhados na mesma altura */}
      <div class="lg:col-span-8 flex">
        {
          profileBilingualEntries.map(({ mode, modeClass, pt, en }) => {
            const ptParagraphs = pt.aboutParagraphs ?? [pt.aboutMe];
            const enParagraphs = en.aboutParagraphs ?? [en.aboutMe];
            return (
              <div class={`${modeClass} about-right-col w-full flex flex-col justify-between gap-6`}>
                <div class="space-y-4">
                  {ptParagraphs.map((paragraph, pIdx) => (
                    <p class="text-base sm:text-lg md:text-xl leading-relaxed text-gray-600 dark:text-slate-300">
                      <BiText pt={paragraph} en={enParagraphs[pIdx] ?? paragraph} />
                    </p>
                  ))}
                </div>

                {mode === "freela" && pt.impactCards && pt.impactCards.length > 0 ? (
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {pt.impactCards.map((card, cIdx) => {
                      const cardEn = en.impactCards?.[cIdx];
                      const icon =
                        card.iconKey !== "comex"
                          ? getTechIconByKey(card.iconKey)
                          : null;
                      return (
                        <article class="rounded-xl sm:rounded-2xl border border-gray-200/90 dark:border-slate-800 bg-gray-50/90 dark:bg-[#111827]/90 p-4 sm:p-5 transition-all duration-300 hover:bg-white dark:hover:bg-[#111827] hover:border-[var(--accent-color)]/60 hover:shadow-md">
                          <div
                            class="w-10 h-10 rounded-lg border border-gray-200/80 dark:border-slate-800 bg-white dark:bg-[#0B0F17]/90 flex items-center justify-center mb-3"
                            aria-hidden="true"
                          >
                            {icon ? (
                              <img
                                src={icon.src}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                class="w-6 h-6 object-contain"
                              />
                            ) : (
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="22"
                                height="22"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="w-5 h-5"
                                style="color: var(--accent-color)"
                              >
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                                <path d="M3.6 9h16.8" />
                                <path d="M3.6 15h16.8" />
                                <path d="M11.5 3a17 17 0 0 0 0 18" />
                                <path d="M12.5 3a17 17 0 0 1 0 18" />
                              </svg>
                            )}
                          </div>
                          <h3 class="text-sm sm:text-base font-bold text-gray-900 dark:text-slate-100 leading-snug">
                            <BiText pt={card.title} en={cardEn?.title ?? card.title} />
                          </h3>
                          <p class="text-xs sm:text-sm text-gray-600 dark:text-slate-300 leading-relaxed mt-1.5">
                            <BiText pt={card.detail} en={cardEn?.detail ?? card.detail} />
                          </p>
                        </article>
                      );
                    })}
                  </div>
                ) : (
                  <>
                    <div class="lang-pt flex flex-wrap gap-2.5 sm:gap-3">
                      {pt.skills.map((skill) => (
                        <TechBadge label={skill} variant="light" />
                      ))}
                    </div>
                    <div class="lang-en flex flex-wrap gap-2.5 sm:gap-3">
                      {en.skills.map((skill) => (
                        <TechBadge label={skill} variant="light" />
                      ))}
                    </div>
                  </>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  :global(html:not([data-mode="freela"])) .profile-glow-card {
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 0 35px -5px rgba(59, 130, 246, 0.35);
  }

  :global(html[data-mode="freela"]) .profile-glow-card {
    border-color: rgba(20, 184, 166, 0.4);
    box-shadow: 0 0 35px -5px rgba(20, 184, 166, 0.35);
  }

  :global(html:not([data-mode="freela"])) .corner-glow-dot {
    background-color: rgba(59, 130, 246, 0.85);
    box-shadow: 0 0 10px 2px rgba(59, 130, 246, 0.75);
  }

  :global(html[data-mode="freela"]) .corner-glow-dot {
    background-color: rgba(20, 184, 166, 0.85);
    box-shadow: 0 0 10px 2px rgba(20, 184, 166, 0.75);
  }
</style>
