---
import { cltConfig, freelaConfig, profileEntries } from "../config";

const hasExperience = profileEntries.some(
  ({ config }) => config.experience.length > 0
);

const CLT_ENGINEERING_STANDARDS = [
  "Arquitetura Resiliente & ACID",
  "Testes Automatizados & CI/CD",
  "Documentação & Runbooks",
] as const;

const OPERATIONAL_METRICS = [
  { label: "AMBIENTE:", value: "Linux & Docker Compose" },
  { label: "GOVERNANÇA:", value: "ODCS v3.2.0 & Pydantic V2" },
  { label: "RASTREABILIDADE:", value: "Audit Logs & Zero-Duplicatas" },
] as const;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          {/* Coluna Esquerda: Título Dinâmico + Card Padrão / Canais */}
          <div class="lg:col-span-4 space-y-5">
            <div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-3xl xl:text-4xl 2xl:text-5xl font-bold text-gray-900 dark:text-slate-100">
                <span class="mode-clt">Experiência</span>
                <span class="mode-freela">Modelo de Atuação</span>
              </h2>
              <div
                class="w-[75px] h-[5px] mt-2 rounded-full transition-colors duration-300"
                style="background-color: var(--accent-color)"
              />
            </div>

            {/* Card modo CLT: Padrão de Engenharia */}
            <div class="mode-clt rounded-xl sm:rounded-2xl border border-gray-200/90 dark:border-slate-800 bg-gray-50/90 dark:bg-[#111827]/90 p-4 sm:p-5 space-y-4">
              <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-gray-200/80 dark:border-slate-800">
                <span
                  class="text-xs font-mono font-bold uppercase tracking-wider"
                  style="color: var(--accent-color)"
                >
                  Padrão de Engenharia
                </span>
                <span class="text-[10px] font-mono text-gray-400 dark:text-slate-500">
                  Production-Ready
                </span>
              </div>

              <ul class="space-y-2.5 text-xs sm:text-[13px] font-mono text-gray-700 dark:text-slate-300">
                {CLT_ENGINEERING_STANDARDS.map((pillar) => (
                  <li class="flex items-center gap-2.5">
                    <span
                      class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[10px] font-bold"
                      style="color: var(--accent-color); background-color: color-mix(in srgb, var(--accent-color) 14%, transparent);"
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                    <span>{pillar}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-1">
                <a
                  href={cltConfig.social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl border border-gray-300/90 dark:border-slate-700 bg-white dark:bg-[#0B0F17]/90 text-xs font-mono font-semibold text-gray-800 dark:text-slate-200 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors duration-200"
                >
                  <span>Inspecionar Repositórios (GitHub)</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            {/* Card modo Freela: Contratação Direta B2B & Escopo Fechado */}
            <div class="mode-freela rounded-xl sm:rounded-2xl border border-gray-200/90 dark:border-slate-800 bg-gray-50/90 dark:bg-[#111827]/90 p-4 sm:p-5 space-y-4">
              <div class="space-y-1.5 pb-2.5 border-b border-gray-200/80 dark:border-slate-800">
                <span
                  class="block text-xs font-mono font-bold uppercase tracking-wider"
                  style="color: var(--accent-color)"
                >
                  Contratação Direta B2B &amp; Escopo Fechado
                </span>
                <p class="text-[11px] sm:text-xs font-mono text-gray-600 dark:text-slate-400 leading-relaxed">
                  Escopo fechado, entrega por marcos e documentação técnica completa.
                </p>
              </div>

              <div class="grid grid-cols-1 gap-2.5">
                <a
                  href={freelaConfig.cta.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-mono font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
                  style="background-color: var(--freela-accent)"
                >
                  <span>Agendar Diagnóstico (WhatsApp)</span>
                  <span aria-hidden="true">↗</span>
                </a>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <a
                    href={freelaConfig.cta.secondaryHref ?? `mailto:${freelaConfig.social.email}`}
                    class="inline-flex items-center justify-between gap-1 px-2.5 py-2 rounded-lg border border-gray-300/90 dark:border-slate-700 bg-white dark:bg-[#0B0F17]/90 text-[11px] leading-tight font-mono font-semibold text-gray-800 dark:text-slate-200 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors duration-200"
                  >
                    <span>Proposta por E-mail</span>
                    <span aria-hidden="true" class="shrink-0">↗</span>
                  </a>
                  <a
                    href={freelaConfig.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-between gap-1 px-2.5 py-2 rounded-lg border border-gray-300/90 dark:border-slate-700 bg-white dark:bg-[#0B0F17]/90 text-[11px] leading-tight font-mono font-semibold text-gray-800 dark:text-slate-200 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors duration-200"
                  >
                    <span>Código Auditado (GitHub)</span>
                    <span aria-hidden="true" class="shrink-0">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          {/* Coluna Direita: Card de Atuação + Rodapé Técnico com 3 Métricas */}
          <div class="lg:col-span-8">
            {profileEntries.map(({ modeClass, config }) => (
              <div class={`${modeClass} relative`}>
                {config.experience.map((exp, index) => (
                  <div class="relative mb-12 last:mb-0">
                    {/* Timeline dot at top of card */}
                    <div
                      class="absolute left-1/2 -top-2 w-4 h-4 bg-white dark:bg-[#0B0F17] border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300"
                      style="border-color: var(--accent-color); background-color: var(--accent-color)"
                    />

                    {/* Connecting line below card */}
                    {index < config.experience.length - 1 && (
                      <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-300 dark:bg-slate-700 -translate-x-1/2 translate-y-full z-10" />
                    )}

                    {/* Experience card */}
                    <article class="bg-white dark:bg-[#111827]/90 rounded-xl sm:rounded-2xl shadow-sm border border-gray-200/90 dark:border-slate-800 p-5 sm:p-6 md:p-8 hover:shadow-md hover:border-gray-300 dark:hover:border-[var(--accent-color)]/60 transition-all duration-300">
                      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                        <div>
                          <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-slate-100">
                            {exp.title}
                          </h3>
                          <p
                            class="text-base sm:text-lg transition-colors duration-300"
                            style="color: var(--accent-color)"
                          >
                            {exp.company}
                          </p>
                        </div>
                        <span class="text-xs sm:text-sm font-mono text-gray-500 dark:text-slate-400 mt-2 sm:mt-0">
                          {exp.dateRange}
                        </span>
                      </div>

                      <ul class="space-y-2.5">
                        {exp.bullets.map((bullet) => (
                          <li class="flex items-start">
                            <span
                              class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 shrink-0"
                              style="background-color: var(--accent-color)"
                            />
                            <span class="text-sm sm:text-base text-gray-600 dark:text-slate-300 leading-relaxed">
                              {bullet}
                            </span>
                          </li>
                        ))}
                      </ul>

                      {/* Barra horizontal discreta com 3 mini-métricas operacionais */}
                      <div class="mt-6 pt-5 border-t border-gray-100 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono">
                        {OPERATIONAL_METRICS.map((metric) => (
                          <div class="rounded-lg border border-gray-200/80 dark:border-slate-800 bg-gray-50/80 dark:bg-[#0B0F17]/80 px-3 py-2">
                            <span
                              class="block text-[10px] font-bold tracking-wider uppercase"
                              style="color: var(--accent-color)"
                            >
                              {metric.label}
                            </span>
                            <span class="block text-xs font-medium text-gray-800 dark:text-slate-200 mt-0.5">
                              {metric.value}
                            </span>
                          </div>
                        ))}
                      </div>
                    </article>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
