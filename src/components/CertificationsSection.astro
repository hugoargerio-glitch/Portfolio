---
import { profileEntries, withBase } from "../config";
import TechBadge from "./TechBadge.astro";

const hasCertifications = profileEntries.some(
  ({ config }) => config.certifications.length > 0
);

const SUMMARY_METRICS = [
  "~400h de carga prática",
  "29 cursos concluídos",
  "2 Capstones aplicados",
] as const;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          {/* Coluna Esquerda: Título + Descrição + Mini-card Resumo Consolidado */}
          <div class="lg:col-span-4 space-y-5">
            <div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-3xl xl:text-4xl 2xl:text-5xl font-bold text-gray-900 dark:text-slate-100">
                Certificações
              </h2>
              <div
                class="w-[75px] h-[5px] mt-2 rounded-full transition-colors duration-300"
                style="background-color: var(--accent-color)"
              />
            </div>

            <p class="mode-clt text-sm sm:text-base text-gray-600 dark:text-slate-300 leading-relaxed">
              Especializações profissionais IBM / Coursera cobrindo engenharia
              de pipelines distribuídos, governança corporativa e arquitetura de
              dados ponta a ponta.
            </p>
            <p class="mode-freela text-sm sm:text-base text-gray-600 dark:text-slate-300 leading-relaxed">
              Formação certificada pela IBM aplicada na entrega de automações
              seguras, bancos rápidos e compliance de dados para empresas.
            </p>

            {/* Mini-card consolidado Formação Verificada IBM */}
            <div class="rounded-xl sm:rounded-2xl border border-gray-200/90 dark:border-slate-800 bg-gray-50/90 dark:bg-[#111827]/90 p-4 sm:p-5 space-y-3.5">
              <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-gray-200/80 dark:border-slate-800">
                <span
                  class="text-xs font-mono font-bold uppercase tracking-wider"
                  style="color: var(--accent-color)"
                >
                  Formação Verificada IBM
                </span>
                <span class="text-[10px] font-mono text-gray-400 dark:text-slate-500">
                  Credly × Coursera
                </span>
              </div>

              <ul class="space-y-2.5 font-mono text-xs sm:text-[13px] text-gray-700 dark:text-slate-300">
                {SUMMARY_METRICS.map((item) => (
                  <li class="flex items-center gap-2.5">
                    <span
                      class="h-1.5 w-1.5 rounded-full shrink-0"
                      style="background-color: var(--accent-color)"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <p class="pt-1 text-[11px] font-mono text-gray-500 dark:text-slate-400 leading-relaxed">
                Data Engineering + Data Architecture • Diplomas auditáveis em
                tela cheia
              </p>
            </div>
          </div>

          {/* Coluna Direita: Cards Expansíveis com Preview + Verificação */}
          <div class="lg:col-span-8">
            {profileEntries.map(({ mode, modeClass, config }) => (
              <div class={`${modeClass} space-y-6`}>
                {config.certifications.map((cert, index) => {
                  const panelId = `cert-panel-${mode}-${index}`;
                  const cardId = `cert-card-${mode}-${index}`;
                  return (
                    <article
                      id={cardId}
                      data-cert-card={cardId}
                      data-open="false"
                      class="cert-card bg-gray-50 dark:bg-[#111827]/90 rounded-xl sm:rounded-2xl border border-gray-200 dark:border-slate-800 transition-all duration-300 hover:bg-white dark:hover:bg-[#111827] hover:shadow-lg dark:hover:border-[var(--accent-color)]/60"
                    >
                      <div class="p-4 sm:p-6 md:p-8">
                        <div class="flex items-start justify-between gap-3 sm:gap-4">
                          <div class="space-y-2 min-w-0">
                            <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                              <img
                                src={withBase("icons/ibm.svg")}
                                alt="IBM"
                                loading="lazy"
                                decoding="async"
                                class="h-5 w-auto shrink-0 dark:brightness-125 transition-all duration-300"
                              />
                              <p
                                class="text-xs sm:text-sm font-mono font-semibold transition-colors duration-300"
                                style="color: var(--accent-color)"
                              >
                                {cert.issuer}
                              </p>
                              <span class="inline-flex items-center px-2 py-0.5 rounded-md border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#0B0F17]/90 text-[11px] font-mono text-gray-600 dark:text-slate-300">
                                {cert.completedDate}
                              </span>
                            </div>

                            <h3 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-slate-100 leading-snug">
                              {cert.name}
                            </h3>
                          </div>

                          <div class="flex items-center gap-2 shrink-0">
                            <a
                              href={cert.verifyUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-gray-300/90 dark:border-slate-700 bg-white dark:bg-[#0B0F17]/90 text-xs font-mono font-semibold text-gray-700 dark:text-slate-200 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors"
                            >
                              <span>Verificar Credencial ↗</span>
                            </a>

                            <button
                              type="button"
                              data-cert-toggle
                              aria-expanded="false"
                              aria-controls={panelId}
                              aria-label={`Expandir detalhes de ${cert.name}`}
                              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/90 text-gray-600 dark:text-slate-300 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                                class="cert-chevron transition-transform duration-300"
                              >
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M6 9l6 6l6 -6" />
                              </svg>
                            </button>
                          </div>
                        </div>

                        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-4">
                          {cert.badges.map((badge) => (
                            <TechBadge label={badge} variant="dark" />
                          ))}
                        </div>
                      </div>

                      <div id={panelId} class="cert-panel">
                        <div class="overflow-hidden">
                          <div class="px-4 pb-5 pt-4 sm:px-6 sm:pb-6 md:px-8 md:pb-8 border-t border-gray-200 dark:border-slate-800">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                              {/* Coluna interna esquerda: Carga horária + 4 pilares exclusivos */}
                              <div class="lg:col-span-7 space-y-4">
                                <div class="flex flex-wrap items-center gap-2 text-[11px] sm:text-xs font-mono">
                                  <span
                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border font-semibold"
                                    style="color: var(--accent-color); border-color: color-mix(in srgb, var(--accent-color) 35%, transparent); background-color: color-mix(in srgb, var(--accent-color) 10%, transparent);"
                                  >
                                    Carga: {cert.workload}
                                  </span>
                                </div>

                                <ul class="space-y-3">
                                  {cert.pillars.map((pillar) => (
                                    <li class="flex items-start gap-2.5 text-xs sm:text-sm leading-relaxed">
                                      <span
                                        class="inline-block w-1.5 h-1.5 rounded-full mt-2 shrink-0 transition-colors duration-300"
                                        style="background-color: var(--accent-color)"
                                      />
                                      <div>
                                        <span class="font-semibold text-gray-900 dark:text-slate-100">
                                          {pillar.title}:
                                        </span>{" "}
                                        <span class="text-gray-600 dark:text-slate-300">
                                          {pillar.detail}
                                        </span>
                                      </div>
                                    </li>
                                  ))}
                                </ul>

                                <div class="pt-1 sm:hidden">
                                  <a
                                    href={cert.verifyUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold hover:opacity-80"
                                    style="color: var(--accent-color)"
                                  >
                                    Verificar Credencial ↗
                                  </a>
                                </div>
                              </div>

                              {/* Coluna interna direita: Preview real do diploma + Lightbox */}
                              <div class="lg:col-span-5">
                                <button
                                  type="button"
                                  data-lightbox-open
                                  data-lightbox-src={cert.imageUrl}
                                  data-lightbox-title={cert.name}
                                  data-lightbox-verify={cert.verifyUrl}
                                  class="group/preview relative w-full text-left rounded-xl border border-gray-200 dark:border-slate-700/80 bg-white dark:bg-[#0B0F17]/90 p-2 shadow-sm transition-all duration-300 hover:border-[var(--accent-color)] hover:shadow-md cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
                                >
                                  <div class="relative overflow-hidden rounded-lg border border-slate-300/60 dark:border-slate-700/60 bg-slate-100 dark:bg-slate-900">
                                    <img
                                      src={cert.imageUrl}
                                      alt={`Diploma oficial: ${cert.name}`}
                                      loading="lazy"
                                      decoding="async"
                                      onerror="this.classList.add('hidden'); this.nextElementSibling?.classList.remove('hidden');"
                                      class="w-full aspect-[4/3] object-cover object-top transition-transform duration-300 group-hover/preview:scale-[1.02]"
                                    />
                                    <div
                                      class="hidden w-full aspect-[4/3] flex flex-col items-center justify-center gap-2 p-4 text-center font-mono text-xs text-slate-500 dark:text-slate-400"
                                      aria-hidden="true"
                                    >
                                      <span>Preview indisponível</span>
                                      <span class="text-[11px] opacity-80">{cert.name}</span>
                                    </div>
                                  </div>

                                  <div class="mt-2 flex items-center justify-between gap-2 px-1">
                                    <span class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold text-gray-700 dark:text-slate-300 group-hover/preview:text-[var(--accent-color)] transition-colors">
                                      <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                      >
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                                        <path d="M7 10l6 0" />
                                        <path d="M10 7l0 6" />
                                        <path d="M21 21l-6 -6" />
                                      </svg>
                                      Clique para ampliar
                                    </span>
                                    <span class="text-[10px] font-mono text-gray-400 dark:text-slate-500">
                                      PNG HD
                                    </span>
                                  </div>
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </article>
                  );
                })}

                {config.complementaryCertifications &&
                  config.complementaryCertifications.length > 0 && (
                    <div class="pt-4 border-t border-gray-200/80 dark:border-slate-800/90 space-y-3">
                      <p class="text-[11px] font-mono font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400">
                        CREDENCIAIS COMPLEMENTARES &amp; GESTÃO
                      </p>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {config.complementaryCertifications.map((comp) => (
                          <div class="rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/90 dark:bg-[#111827]/90 p-3.5 flex flex-col justify-between gap-2.5 transition-colors duration-200 hover:bg-white dark:hover:bg-[#111827] hover:border-[var(--accent-color)]/60">
                            <div class="flex items-start gap-3">
                              <div class="shrink-0 h-9 w-12 rounded-lg border border-gray-200/80 dark:border-slate-800 bg-white dark:bg-[#0B0F17]/90 px-1.5 flex items-center justify-center">
                                <img
                                  src={comp.logoSrc}
                                  alt={comp.issuer}
                                  loading="lazy"
                                  decoding="async"
                                  class={`max-h-5 w-auto object-contain ${
                                    comp.invertOnDark
                                      ? "dark:brightness-0 dark:invert"
                                      : ""
                                  }`.trim()}
                                />
                              </div>
                              <div class="min-w-0">
                                <p class="text-[11px] font-mono text-gray-500 dark:text-slate-400 leading-none">
                                  {comp.issuer}
                                </p>
                                <h3 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-slate-100 leading-snug mt-1">
                                  {comp.title}
                                </h3>
                                <p class="text-[11px] text-gray-600 dark:text-slate-300 mt-0.5 leading-snug">
                                  {comp.subtitle}
                                </p>
                              </div>
                            </div>

                            <div class="flex items-center justify-between gap-2 pt-2 border-t border-gray-200/70 dark:border-slate-800/80 text-[11px] font-mono">
                              <span class="text-gray-500 dark:text-slate-400">
                                ID: {comp.credentialId}
                              </span>
                              <a
                                href={comp.verifyUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-semibold hover:opacity-80 transition-opacity"
                                style="color: var(--accent-color)"
                              >
                                Verificar ↗
                              </a>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Modal Lightbox Leve para Diploma em Alta Resolução */}
      <div
        id="cert-lightbox"
        role="dialog"
        aria-modal="true"
        aria-labelledby="cert-lightbox-title"
        class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-8 bg-slate-950/85 backdrop-blur-md"
      >
        <div
          data-lightbox-panel
          class="relative w-full max-w-5xl rounded-2xl border border-slate-700/80 bg-[#0B0F17] p-3 sm:p-5 shadow-2xl space-y-3"
        >
          <div class="flex items-center justify-between gap-3 px-1">
            <h3
              id="cert-lightbox-title"
              class="text-xs sm:text-sm font-mono font-semibold text-slate-100 truncate"
            />
            <div class="flex items-center gap-2 shrink-0">
              <a
                id="cert-lightbox-verify"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-slate-700 bg-slate-900 text-[11px] font-mono font-semibold text-slate-200 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] transition-colors"
              >
                Verificar Credencial ↗
              </a>
              <button
                type="button"
                data-lightbox-close
                aria-label="Fechar visualização do certificado"
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-700 bg-slate-900 text-slate-300 hover:text-white hover:border-slate-500 transition-colors cursor-pointer"
              >
                ✕
              </button>
            </div>
          </div>

          <div class="flex items-center justify-center rounded-xl bg-slate-900/80 border border-slate-800 p-2 overflow-hidden">
            <img
              id="cert-lightbox-img"
              src=""
              alt=""
              class="max-h-[78vh] w-auto max-w-full rounded-lg object-contain"
            />
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  const certCards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-cert-card]")
  );

  const setCertOpen = (card: HTMLElement, open: boolean) => {
    const next = String(open);
    card.setAttribute("data-open", next);
    card
      .querySelector("[data-cert-toggle]")
      ?.setAttribute("aria-expanded", next);
  };

  let certAutoObserver: IntersectionObserver | null = null;

  if ("IntersectionObserver" in window && certCards.length > 0) {
    certAutoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || entry.intersectionRatio < 0.35) return;
          const card = entry.target as HTMLElement;
          if (card.offsetParent === null) return;

          if (card.getAttribute("data-auto-opened") === "true") {
            certAutoObserver?.unobserve(card);
            return;
          }

          card.setAttribute("data-auto-opened", "true");
          certAutoObserver?.unobserve(card);
          if (card.getAttribute("data-open") !== "true") {
            setCertOpen(card, true);
          }
        });
      },
      { threshold: 0.35 }
    );

    certCards.forEach((card) => certAutoObserver?.observe(card));
  }

  document.querySelectorAll("[data-cert-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest<HTMLElement>("[data-cert-card]");
      if (!card) return;
      const isOpen = card.getAttribute("data-open") === "true";
      card.setAttribute("data-auto-opened", "true");
      certAutoObserver?.unobserve(card);
      setCertOpen(card, !isOpen);
    });
  });

  // Modal Lightbox para visualização em alta resolução
  const lightbox = document.getElementById("cert-lightbox");
  const lightboxImg = document.getElementById("cert-lightbox-img") as HTMLImageElement | null;
  const lightboxTitle = document.getElementById("cert-lightbox-title");
  const lightboxVerify = document.getElementById("cert-lightbox-verify") as HTMLAnchorElement | null;
  const closeBtn = lightbox?.querySelector<HTMLElement>("[data-lightbox-close]");
  let lastTrigger: HTMLElement | null = null;

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
    lastTrigger?.focus();
  };

  document.querySelectorAll<HTMLElement>("[data-lightbox-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!lightbox || !lightboxImg) return;
      const src = btn.getAttribute("data-lightbox-src") ?? "";
      const title = btn.getAttribute("data-lightbox-title") ?? "";
      const verify = btn.getAttribute("data-lightbox-verify") ?? "#";

      lastTrigger = btn;
      lightboxImg.src = src;
      lightboxImg.alt = `Diploma oficial em alta resolução: ${title}`;
      if (lightboxTitle) lightboxTitle.textContent = title;
      if (lightboxVerify) lightboxVerify.href = verify;

      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) {
      closeLightbox();
    }
  });
</script>

<style>
  .cert-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: all 300ms ease;
  }

  .cert-card[data-open="true"] {
    background-color: white;
    border-color: var(--accent-color);
  }

  :global(html.dark) .cert-card[data-open="true"] {
    background-color: #111827;
    border-color: var(--accent-color);
  }

  .cert-card[data-open="true"] .cert-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .cert-card[data-open="true"] .cert-chevron {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .cert-card:hover {
      border-color: color-mix(in srgb, var(--accent-color) 45%, white);
    }

    :global(html.dark) .cert-card:hover {
      border-color: color-mix(in srgb, var(--accent-color) 55%, transparent);
    }
  }
</style>
