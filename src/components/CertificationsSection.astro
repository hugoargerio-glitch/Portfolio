---
import { profileEntries } from "../config";

const hasCertifications = profileEntries.some(
  ({ config }) => config.certifications.length > 0
);
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4 space-y-4">
            <div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
                Certificações
              </h2>
              <div
                class="w-[75px] h-[5px] mt-2 rounded-full transition-colors duration-300"
                style="background-color: var(--accent-color)"
              />
            </div>
            <p class="mode-clt text-sm sm:text-base text-gray-600 leading-relaxed">
              Credenciais verificadas IBM / Coursera cobrindo engenharia distribuída,
              pipelines streaming, bancos relacionais/NoSQL e governança corporativa.
            </p>
            <p class="mode-freela text-sm sm:text-base text-gray-600 leading-relaxed">
              Formação certificada pela IBM aplicada na entrega de automações
              seguras, bancos rápidos e compliance de dados para empresas.
            </p>
          </div>

          <div class="lg:col-span-8">
            {profileEntries.map(({ mode, modeClass, config }) => (
              <div class={`${modeClass} space-y-6`}>
                {config.certifications.map((cert, index) => {
                  const panelId = `cert-panel-${mode}-${index}`;
                  return (
                    <article
                      data-open="false"
                      class="cert-card bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-lg"
                    >
                      <button
                        type="button"
                        data-cert-toggle
                        aria-expanded="false"
                        aria-controls={panelId}
                        class="w-full p-4 sm:p-6 md:p-8 text-left cursor-pointer rounded-xl sm:rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
                      >
                        <div class="flex items-start justify-between gap-4">
                          <div class="space-y-1.5">
                            <p
                              class="text-xs sm:text-sm font-mono font-semibold transition-colors duration-300"
                              style="color: var(--accent-color)"
                            >
                              {cert.issuer}
                            </p>
                            <h3 class="text-lg sm:text-2xl font-bold text-gray-900">
                              {cert.name}
                            </h3>
                          </div>

                          <span class="shrink-0 mt-1 inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-600 transition-colors duration-300">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="18"
                              height="18"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              class="cert-chevron transition-transform duration-300"
                            >
                              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                              <path d="M6 9l6 6l6 -6" />
                            </svg>
                          </span>
                        </div>

                        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-4">
                          {cert.badges.map((badge) => (
                            <span class="px-2.5 sm:px-3 py-1 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                              {badge}
                            </span>
                          ))}
                        </div>

                        <p class="mt-3 text-xs text-gray-500">
                          Passe o mouse ou clique para ver os pilares estudados
                        </p>
                      </button>

                      <div id={panelId} class="cert-panel">
                        <div class="overflow-hidden">
                          <div class="px-4 pb-5 pt-1 sm:px-6 sm:pb-6 md:px-8 md:pb-8 border-t border-gray-200 space-y-3">
                            <ul class="space-y-3 pt-3">
                              {cert.pillars.map((pillar) => (
                                <li class="flex items-start gap-3 text-sm sm:text-base">
                                  <span
                                    class="inline-block w-1.5 h-1.5 rounded-full mt-2 shrink-0 transition-colors duration-300"
                                    style="background-color: var(--accent-color)"
                                  />
                                  <div>
                                    <span class="font-semibold text-gray-900">
                                      {pillar.title}:
                                    </span>{" "}
                                    <span class="text-gray-600">
                                      {pillar.detail}
                                    </span>
                                  </div>
                                </li>
                              ))}
                            </ul>

                            {cert.credentialUrl && (
                              <div class="pt-2">
                                <a
                                  href={cert.credentialUrl}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold hover:opacity-80"
                                  style="color: var(--accent-color)"
                                >
                                  Verificar credencial no Credly →
                                </a>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll("[data-cert-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest(".cert-card");
      if (!card) return;
      const isOpen = card.getAttribute("data-open") === "true";
      const next = String(!isOpen);
      card.setAttribute("data-open", next);
      btn.setAttribute("aria-expanded", next);
    });
  });
</script>

<style>
  .cert-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: all 300ms ease;
  }

  .cert-card[data-open="true"] {
    background-color: white;
    border-color: var(--accent-color);
  }

  .cert-card[data-open="true"] .cert-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .cert-card[data-open="true"] .cert-chevron {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .cert-card:hover {
      border-color: color-mix(in srgb, var(--accent-color) 45%, white);
    }

    .cert-card:hover .cert-panel {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .cert-card:hover .cert-chevron {
      transform: rotate(180deg);
    }
  }
</style>
