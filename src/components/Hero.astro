---
import { cltConfig, freelaConfig, siteConfig } from "../config";
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-white min-h-screen flex flex-col justify-between"
>
  <!-- Gradient overlays por modo (zero flash na pintura inicial) -->
  <div
    aria-hidden="true"
    class="hero-bg-clt absolute inset-0 -z-10 transition-opacity duration-500"
    style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${cltConfig.accentColor}40 0%, ${cltConfig.accentColor}25 20%, ${cltConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
  >
  </div>
  <div
    aria-hidden="true"
    class="hero-bg-freela absolute inset-0 -z-10 transition-opacity duration-500"
    style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${freelaConfig.accentColor}40 0%, ${freelaConfig.accentColor}25 20%, ${freelaConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
  >
  </div>

  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="0787a7c5-978c-4f66-83c7-11c213f99cb7"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <g style="fill: var(--accent-color)">
          <text x="50" y="50" font-family="monospace" font-size="24" transform="rotate(-15)">&lt;/&gt;</text>
          <text x="150" y="100" font-family="monospace" font-size="20" transform="rotate(10)">{"{}"}</text>
          <text x="250" y="80" font-family="monospace" font-size="18" transform="rotate(-5)">=&gt;</text>
          <text x="100" y="200" font-family="monospace" font-size="22" transform="rotate(15)">[]</text>
          <text x="300" y="180" font-family="monospace" font-size="20" transform="rotate(-10)">&lt;&gt;</text>
          <text x="200" y="250" font-family="monospace" font-size="24" transform="rotate(5)">()</text>
          <text x="50" y="320" font-family="monospace" font-size="18" transform="rotate(-8)">::</text>
          <text x="350" y="300" font-family="monospace" font-size="22" transform="rotate(12)">==</text>
          <text x="150" y="350" font-family="monospace" font-size="20" transform="rotate(-15)">++</text>
          <text x="250" y="370" font-family="monospace" font-size="24" transform="rotate(8)">;</text>
        </g>
      </pattern>
    </defs>
    <rect fill="url(#programming-symbols)" width="100%" height="100%" opacity="0.2"></rect>
    <rect fill="url(#0787a7c5-978c-4f66-83c7-11c213f99cb7)" width="100%" height="100%" stroke-width={0}></rect>
  </svg>

  <div class="w-full flex-1 flex items-center px-8 pt-24 pb-8 sm:px-12 sm:pt-28 md:px-24 md:pt-28">
    <div class="max-w-5xl">
      <p class="text-pretty text-xl sm:text-2xl md:text-4xl font-bold tracking-tight text-gray-700 animate-fade-in">
        Olá! 👋
      </p>
      <h1 class="mt-4 sm:mt-6 md:mt-8 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-bold tracking-tight text-gray-800 animate-fade-in animation-delay-200">
        Eu sou <span class="transition-colors duration-300" style="color: var(--accent-color)">{siteConfig.name}</span>
      </h1>

      <p class="mode-clt mt-4 sm:mt-6 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 animate-fade-in animation-delay-400">
        {cltConfig.title}
      </p>
      <p class="mode-freela mt-4 sm:mt-6 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 animate-fade-in animation-delay-400">
        {freelaConfig.title}
      </p>

      <!-- Seletor interativo de duas engrenagens -->
      <div
        role="group"
        aria-label="Selecionar modo de visualização do portfólio"
        class="mt-6 sm:mt-8 grid grid-cols-1 sm:inline-grid sm:grid-cols-2 gap-3 w-full sm:w-auto animate-fade-in animation-delay-400"
      >
        <button
          type="button"
          data-mode-btn="clt"
          aria-pressed="true"
          class="mode-btn mode-btn-clt group flex items-center gap-2.5 sm:gap-3 px-3 py-2.5 sm:px-4 sm:py-3 rounded-xl border bg-white/90 backdrop-blur-sm text-left transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--clt-accent)]"
        >
          <span class="gear-badge gear-badge-clt flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-lg border transition-colors duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="gear-icon gear-clt transition-transform duration-500 ease-out"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" />
              <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
            </svg>
          </span>
          <span class="min-w-0">
            <span class="block text-xs sm:text-sm font-semibold text-gray-900 leading-snug">
              Modo Recrutador (CLT / Tech)
            </span>
            <span class="block text-[11px] sm:text-xs text-gray-600 leading-snug mt-0.5">
              Arquitetura, Stack &amp; ODCS v3.2.0
            </span>
          </span>
        </button>

        <button
          type="button"
          data-mode-btn="freela"
          aria-pressed="false"
          class="mode-btn mode-btn-freela group flex items-center gap-2.5 sm:gap-3 px-3 py-2.5 sm:px-4 sm:py-3 rounded-xl border bg-white/90 backdrop-blur-sm text-left transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--freela-accent)]"
        >
          <span class="gear-badge gear-badge-freela flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-lg border transition-colors duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="gear-icon gear-freela transition-transform duration-500 ease-out"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" />
              <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
            </svg>
          </span>
          <span class="min-w-0">
            <span class="block text-xs sm:text-sm font-semibold text-gray-900 leading-snug">
              Modo Empresa (Freelancer B2B)
            </span>
            <span class="block text-[11px] sm:text-xs text-gray-600 leading-snug mt-0.5">
              ROI, Automação &amp; Pacotes B2B
            </span>
          </span>
        </button>
      </div>

      <!-- CTA dinâmico por modo -->
      <div class="mt-6 flex flex-wrap items-center gap-3 animate-fade-in animation-delay-600">
        <a
          href={cltConfig.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mode-clt inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-5 py-3 rounded-xl text-sm sm:text-base font-semibold text-white shadow-sm transition-all duration-300 hover:opacity-95 hover:-translate-y-0.5"
          style="background-color: var(--clt-accent)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="shrink-0"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
            <path d="M7 11l5 5l5 -5" />
            <path d="M12 4l0 12" />
          </svg>
          {cltConfig.cta.label}
        </a>

        <a
          href={freelaConfig.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mode-freela inline-flex items-center justify-center w-full sm:w-auto px-4 sm:px-5 py-3 rounded-xl text-[13px] sm:text-base font-semibold text-white shadow-sm transition-all duration-300 hover:opacity-95 hover:-translate-y-0.5 text-center"
          style="background-color: var(--freela-accent)"
        >
          <span>
            {freelaConfig.cta.label}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="inline-block ml-1.5 -mt-0.5 shrink-0"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M7 17l10 -10" />
              <path d="M7 7h10v10" />
            </svg>
          </span>
        </a>

        {
          freelaConfig.cta.secondaryHref && freelaConfig.cta.secondaryLabel && (
            <a
              href={freelaConfig.cta.secondaryHref}
              class="mode-freela inline-flex items-center justify-center w-full sm:w-auto gap-2 px-4 py-3 rounded-xl border border-gray-300 bg-white/90 text-sm sm:text-base font-medium text-gray-700 transition-colors duration-300 hover:border-gray-400 hover:text-gray-900"
            >
              {freelaConfig.cta.secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div
    class="px-8 pb-8 pt-4 sm:px-12 sm:pb-12 md:px-24 md:pb-16 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-700 animate-fade-in animation-delay-600"
  >
    {
      siteConfig.social?.email && (
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.whatsapp && (
        <a
          href={siteConfig.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
            <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.twitter && (
        <a
          href={siteConfig.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.github && (
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </>
          </svg>
        </a>
      )
    }
  </div>
</section>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll("[data-mode-btn]");
    const syncPressed = (mode) => {
      buttons.forEach((btn) =>
        btn.setAttribute("aria-pressed", String(btn.getAttribute("data-mode-btn") === mode))
      );
    };

    syncPressed(document.documentElement.dataset.mode === "freela" ? "freela" : "clt");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-mode-btn") === "freela" ? "freela" : "clt";
        document.documentElement.dataset.mode = mode;
        syncPressed(mode);
        const url = new URL(window.location.href);
        url.searchParams.set("modo", mode);
        window.history.replaceState({}, "", url);
      });
    });
  })();
</script>

<style>
  .hero-bg-freela {
    opacity: 0;
  }

  .hero-bg-clt {
    opacity: 1;
  }

  :global(html[data-mode="freela"]) .hero-bg-clt {
    opacity: 0;
  }

  :global(html[data-mode="freela"]) .hero-bg-freela {
    opacity: 1;
  }

  /* Estado visual das engrenagens + rotação acoplada oposta */
  .mode-btn {
    border-color: rgb(209 213 219);
  }

  .gear-badge {
    border-color: rgb(209 213 219);
    background-color: rgb(249 250 251);
    color: rgb(75 85 99);
  }

  :global(html:not([data-mode="freela"])) .mode-btn-clt {
    border-color: var(--clt-accent);
    background-color: color-mix(in srgb, var(--clt-accent) 6%, white);
    box-shadow: 0 4px 14px -4px color-mix(in srgb, var(--clt-accent) 25%, transparent);
  }

  :global(html:not([data-mode="freela"])) .gear-badge-clt {
    border-color: color-mix(in srgb, var(--clt-accent) 30%, white);
    background-color: color-mix(in srgb, var(--clt-accent) 12%, white);
    color: var(--clt-accent);
  }

  :global(html[data-mode="freela"]) .mode-btn-freela {
    border-color: var(--freela-accent);
    background-color: color-mix(in srgb, var(--freela-accent) 6%, white);
    box-shadow: 0 4px 14px -4px color-mix(in srgb, var(--freela-accent) 25%, transparent);
  }

  :global(html[data-mode="freela"]) .gear-badge-freela {
    border-color: color-mix(in srgb, var(--freela-accent) 30%, white);
    background-color: color-mix(in srgb, var(--freela-accent) 12%, white);
    color: var(--freela-accent);
  }

  .gear-clt,
  .gear-freela {
    transform: rotate(0deg);
  }

  :global(html[data-mode="freela"]) .gear-clt {
    transform: rotate(90deg);
  }

  :global(html[data-mode="freela"]) .gear-freela {
    transform: rotate(-90deg);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
</style>
