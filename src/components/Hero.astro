---
import { cltConfig, freelaConfig, siteConfig } from "../config";
import { cltConfigEn, freelaConfigEn } from "../i18n/configs";
import { getTechIconByKey } from "../utils/techIcons";
import BiText from "./BiText.astro";

const GEAR_PRIMARY_PATH =
  "M19.07,5.85 L20.43,1.98 L22.81,2.53 L22.35,6.60 L24.28,7.54 L26.01,8.80 L29.38,6.47 L30.99,8.31 L28.22,11.33 L29.23,13.23 L29.89,15.26 L33.98,15.37 L34.20,17.80 L30.18,18.61 L29.89,20.74 L29.23,22.77 L32.48,25.26 L31.22,27.36 L27.50,25.66 L26.01,27.20 L24.28,28.46 L25.45,32.39 L23.20,33.34 L21.18,29.78 L19.07,30.15 L16.93,30.15 L15.57,34.02 L13.19,33.47 L13.65,29.40 L11.72,28.46 L9.99,27.20 L6.62,29.53 L5.01,27.69 L7.78,24.67 L6.77,22.77 L6.11,20.74 L2.02,20.63 L1.80,18.20 L5.82,17.39 L6.11,15.26 L6.77,13.23 L3.52,10.74 L4.78,8.64 L8.50,10.34 L9.99,8.80 L11.72,7.54 L10.55,3.61 L12.80,2.66 L14.82,6.22 L16.93,5.85 Z M 23.2,18 A 5.2,5.2 0 1,0 12.8,18 A 5.2,5.2 0 1,0 23.2,18 Z";

const GEAR_SECONDARY_PATH =
  "M15.03,4.66 L16.44,1.23 L18.79,1.91 L18.14,5.56 L19.88,6.66 L21.34,8.12 L24.75,6.69 L25.93,8.84 L22.89,10.96 L23.34,12.97 L23.34,15.03 L26.77,16.44 L26.09,18.79 L22.44,18.14 L21.34,19.88 L19.88,21.34 L21.31,24.75 L19.16,25.93 L17.04,22.89 L15.03,23.34 L12.97,23.34 L11.56,26.77 L9.21,26.09 L9.86,22.44 L8.12,21.34 L6.66,19.88 L3.25,21.31 L2.07,19.16 L5.11,17.04 L4.66,15.03 L4.66,12.97 L1.23,11.56 L1.91,9.21 L5.56,9.86 L6.66,8.12 L8.12,6.66 L6.69,3.25 L8.84,2.07 L10.96,5.11 L12.97,4.66 Z M 18,14 A 4,4 0 1,0 10,14 A 4,4 0 1,0 18,14 Z";

const heroPipelineStages = [
  {
    step: "01",
    iconKey: "python" as const,
    cltTagPt: "FONTES",
    cltTagEn: "SOURCES",
    cltTitlePt: "BACEN PTAX · MDIC · Market Feeds",
    cltTitleEn: "BACEN PTAX · Trade APIs · Market Feeds",
    freelaTagPt: "ENTRADA",
    freelaTagEn: "INPUT",
    freelaTitlePt: "ERPs, Planilhas & Cotações",
    freelaTitleEn: "ERPs, Spreadsheets & FX Rates",
  },
  {
    step: "02",
    iconKey: "databricks" as const,
    cltTagPt: "SHIFT-LEFT",
    cltTagEn: "SHIFT-LEFT",
    cltTitlePt: "Contratos ODCS v3.2.0 + Pydantic V2",
    cltTitleEn: "ODCS v3.2.0 Contracts + Pydantic V2",
    freelaTagPt: "BLINDAGEM",
    freelaTagEn: "SAFEGUARD",
    freelaTitlePt: "Filtro Anti-Erro & Zero Duplicatas",
    freelaTitleEn: "Error Shield & Zero Duplicates",
  },
  {
    step: "03",
    iconKey: "postgresql" as const,
    cltTagPt: "STORAGE ACID",
    cltTagEn: "ACID STORAGE",
    cltTitlePt: "PostgreSQL 16 · Delta Lake · SQLite WAL",
    cltTitleEn: "PostgreSQL 16 · Delta Lake · SQLite WAL",
    freelaTagPt: "BANCO ÚNICO",
    freelaTagEn: "SINGLE DB",
    freelaTitlePt: "Base Relacional em Docker Compose",
    freelaTitleEn: "Relational Store in Docker Compose",
  },
  {
    step: "04",
    iconKey: "snowflake" as const,
    cltTagPt: "SERVING & OBS",
    cltTagEn: "SERVING & OBS",
    cltTitlePt: "Snowflake Kimball · DuckDB · Outbox",
    cltTitleEn: "Snowflake Kimball · DuckDB · Outbox",
    freelaTagPt: "RESULTADO",
    freelaTagEn: "OUTPUT",
    freelaTitlePt: "Power BI Diário & Alertas 24/7",
    freelaTitleEn: "Daily Power BI & 24/7 Alerts",
  },
] as const;
---

<section
  id="hero"
  class="relative overflow-hidden min-h-screen flex flex-col justify-between transition-colors duration-300"
>
  <!-- Gradient overlays por modo (zero flash na pintura inicial) -->
  <div
    aria-hidden="true"
    class="hero-bg-clt absolute inset-0 -z-10 pointer-events-none transition-opacity duration-500"
  >
  </div>
  <div
    aria-hidden="true"
    class="hero-bg-freela absolute inset-0 -z-10 pointer-events-none transition-opacity duration-500"
  >
  </div>

  <div class="w-full flex-1 flex items-center px-8 pt-24 pb-8 sm:px-12 sm:pt-28 md:px-20 lg:px-24 md:pt-28">
    <div class="w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Coluna esquerda: Identidade, Engrenagens e CTA (7 colunas) -->
      <div class="lg:col-span-7">
        <p class="text-pretty text-xl sm:text-2xl md:text-4xl font-bold tracking-tight text-gray-700 dark:text-slate-300 animate-fade-in">
          <BiText pt="Olá! 👋" en="Hi there! 👋" />
        </p>
        <h1 class="mt-4 sm:mt-6 md:mt-8 text-pretty text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-bold tracking-tight text-gray-800 dark:text-slate-100 animate-fade-in animation-delay-200">
          <BiText pt="Eu sou " en="I'm " /><span class="transition-colors duration-300" style="color: var(--accent-color)">{siteConfig.name}</span>
        </h1>

        <p class="mode-clt mt-4 sm:mt-6 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 dark:text-slate-300 animate-fade-in animation-delay-400">
          <BiText pt={cltConfig.title} en={cltConfigEn.title} />
        </p>
        <p class="mode-freela mt-4 sm:mt-6 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 dark:text-slate-300 animate-fade-in animation-delay-400">
          <BiText pt={freelaConfig.title} en={freelaConfigEn.title} />
        </p>

        <!-- Seletor interativo de engrenagens mecânicas acopladas -->
        <div
          role="group"
          data-mode-dock
          aria-label="Selecionar modo de visualização do portfólio"
          class="mode-dock mt-6 sm:mt-8 rounded-2xl border border-gray-200 dark:border-slate-800 p-1.5 sm:p-2 bg-white/90 dark:bg-[#111827]/90 backdrop-blur-sm transition-all duration-300 flex flex-col sm:inline-flex sm:flex-row sm:items-stretch gap-2 w-full sm:w-auto animate-fade-in animation-delay-400"
        >
          {/* Câmara das 2 engrenagens acopladas (36px + 28px) com halo ativo */}
          <div
            aria-hidden="true"
            class="gear-chamber relative shrink-0 h-14 sm:h-auto sm:w-[78px] rounded-xl border border-gray-200/80 dark:border-slate-800 bg-gray-50/90 dark:bg-[#0B0F17]/90 flex items-center justify-center overflow-hidden transition-all duration-500"
          >
            <div class="gear-halo absolute inset-0 pointer-events-none transition-all duration-500" />
            <div class="relative w-[58px] h-[50px]">
              <svg
                width="36"
                height="36"
                viewBox="0 0 36 36"
                fill="currentColor"
                fill-rule="evenodd"
                class="gear-primary absolute top-0.5 left-0.5 w-[36px] h-[36px] transition-transform duration-500 ease-out"
                style="color: var(--accent-color)"
              >
                <path d={GEAR_PRIMARY_PATH} />
              </svg>
              <svg
                width="28"
                height="28"
                viewBox="0 0 28 28"
                fill="currentColor"
                fill-rule="evenodd"
                class="gear-secondary absolute top-[21px] left-[27px] w-[28px] h-[28px] text-gray-500 dark:text-slate-400 transition-transform duration-500 ease-out"
              >
                <path d={GEAR_SECONDARY_PATH} />
              </svg>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 flex-1">
            <button
              type="button"
              data-mode-btn="clt"
              aria-pressed="true"
              class="mode-btn mode-btn-clt group flex flex-col justify-center px-3.5 py-2.5 sm:px-4 sm:py-2.5 rounded-xl border border-transparent text-left transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--clt-accent)]"
            >
              <span class="block text-xs sm:text-sm font-semibold text-gray-900 dark:text-slate-100 leading-snug">
                <BiText
                  pt="Modo Recrutador (CLT / Tech)"
                  en="Recruiter View (Full-Time / Tech)"
                />
              </span>
              <span class="block text-[11px] sm:text-xs text-gray-600 dark:text-slate-400 leading-snug mt-0.5">
                <BiText
                  pt="Arquitetura, Stack & ODCS v3.2.0"
                  en="Architecture, Stack & ODCS v3.2.0"
                />
              </span>
            </button>

            <button
              type="button"
              data-mode-btn="freela"
              aria-pressed="false"
              class="mode-btn mode-btn-freela group flex flex-col justify-center px-3.5 py-2.5 sm:px-4 sm:py-2.5 rounded-xl border border-transparent text-left transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--freela-accent)]"
            >
              <span class="block text-xs sm:text-sm font-semibold text-gray-900 dark:text-slate-100 leading-snug">
                <BiText
                  pt="Modo Empresa (Freelancer B2B)"
                  en="Client View (B2B Consulting)"
                />
              </span>
              <span class="block text-[11px] sm:text-xs text-gray-600 dark:text-slate-400 leading-snug mt-0.5">
                <BiText
                  pt="ROI, Automação & Pacotes B2B"
                  en="ROI, Automation & B2B Packages"
                />
              </span>
            </button>
          </div>
        </div>

        <!-- CTA dinâmico por modo -->
        <div class="mt-6 flex flex-wrap items-center gap-3 animate-fade-in animation-delay-600">
          <a
            href={cltConfig.cta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mode-clt inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-5 py-3 rounded-xl text-sm sm:text-base font-semibold text-white shadow-sm transition-all duration-300 hover:opacity-95 hover:-translate-y-0.5"
            style="background-color: var(--clt-accent)"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="shrink-0"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
              <path d="M7 11l5 5l5 -5" />
              <path d="M12 4l0 12" />
            </svg>
            <BiText pt={cltConfig.cta.label} en={cltConfigEn.cta.label} />
          </a>

          <span class="mode-freela inline-flex w-full sm:w-auto">
            <a
              href={freelaConfig.cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="lang-pt inline-flex items-center justify-center w-full sm:w-auto px-4 sm:px-5 py-3 rounded-xl text-[13px] sm:text-base font-semibold text-white shadow-sm transition-all duration-300 hover:opacity-95 hover:-translate-y-0.5 text-center"
              style="background-color: var(--freela-accent)"
            >
              <span>
                {freelaConfig.cta.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="inline-block ml-1.5 -mt-0.5 shrink-0"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M7 17l10 -10" />
                  <path d="M7 7h10v10" />
                </svg>
              </span>
            </a>
            <a
              href={freelaConfigEn.cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="lang-en inline-flex items-center justify-center w-full sm:w-auto px-4 sm:px-5 py-3 rounded-xl text-[13px] sm:text-base font-semibold text-white shadow-sm transition-all duration-300 hover:opacity-95 hover:-translate-y-0.5 text-center"
              style="background-color: var(--freela-accent)"
            >
              <span>
                {freelaConfigEn.cta.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="inline-block ml-1.5 -mt-0.5 shrink-0"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M7 17l10 -10" />
                  <path d="M7 7h10v10" />
                </svg>
              </span>
            </a>
          </span>

          {
            freelaConfig.cta.secondaryHref && freelaConfig.cta.secondaryLabel && (
              <span class="mode-freela inline-flex w-full sm:w-auto">
                <a
                  href={freelaConfig.cta.secondaryHref}
                  class="lang-pt inline-flex items-center justify-center w-full sm:w-auto gap-2 px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-700 bg-white/90 dark:bg-[#111827]/90 text-sm sm:text-base font-medium text-gray-700 dark:text-slate-200 transition-colors duration-300 hover:border-gray-400 dark:hover:border-[var(--accent-color)] hover:text-gray-900 dark:hover:text-slate-100"
                >
                  {freelaConfig.cta.secondaryLabel}
                </a>
                {freelaConfigEn.cta.secondaryHref && freelaConfigEn.cta.secondaryLabel && (
                  <a
                    href={freelaConfigEn.cta.secondaryHref}
                    class="lang-en inline-flex items-center justify-center w-full sm:w-auto gap-2 px-4 py-3 rounded-xl border border-gray-300 dark:border-slate-700 bg-white/90 dark:bg-[#111827]/90 text-sm sm:text-base font-medium text-gray-700 dark:text-slate-200 transition-colors duration-300 hover:border-gray-400 dark:hover:border-[var(--accent-color)] hover:text-gray-900 dark:hover:text-slate-100"
                  >
                    {freelaConfigEn.cta.secondaryLabel}
                  </a>
                )}
              </span>
            )
          }
        </div>

        <!-- Barra de Telemetria / Prova Rápida -->
        <div class="mt-6 pt-5 border-t border-gray-200/80 dark:border-slate-800/80 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] sm:text-xs font-mono text-gray-600 dark:text-slate-400 animate-fade-in animation-delay-600">
          <span>
            <strong class="text-gray-900 dark:text-slate-200 font-semibold">ODCS v3.2.0</strong> • <BiText pt="Contratos Executáveis" en="Executable Data Contracts" />
          </span>
          <span aria-hidden="true" class="hidden sm:inline text-gray-300 dark:text-slate-700">|</span>
          <span>
            <strong class="text-gray-900 dark:text-slate-200 font-semibold">100% Docker</strong> • Linux &amp; CI/CD Verified
          </span>
          <span aria-hidden="true" class="hidden sm:inline text-gray-300 dark:text-slate-700">|</span>
          <span>
            <strong class="text-gray-900 dark:text-slate-200 font-semibold"><BiText pt="Comex & Dados" en="Trade & Data" /></strong> • PUCRS (2026) + IBM Certified
          </span>
        </div>
      </div>

      <!-- Coluna direita: Diagrama minimalista animado de pipeline (5 colunas, desktop) -->
      <aside
        data-pipeline-aside
        aria-label="Arquitetura de pipeline de dados"
        class="hidden lg:flex lg:col-span-5 items-center justify-center animate-fade-in animation-delay-400"
      >
        <div class="pipeline-card w-full max-w-lg rounded-2xl border border-gray-200/90 dark:border-slate-800 bg-white/90 dark:bg-[#111827]/95 backdrop-blur-md p-6 shadow-md transition-all duration-300">
          <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-gray-100 dark:border-slate-800">
            <span class="mode-clt text-xs font-mono font-semibold text-gray-600 dark:text-slate-400">
              pipeline_topology · ODCS v3.2.0
            </span>
            <span class="mode-freela text-xs font-mono font-semibold text-gray-600 dark:text-slate-400">
              <BiText pt="automacao_b2b · SLA Ativo" en="b2b_automation · Active SLA" />
            </span>
            <span
              class="inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold"
              style="color: var(--accent-color)"
            >
              <span
                class="h-2 w-2 rounded-full animate-pulse"
                style="background-color: var(--accent-color)"
              />
              <span class="mode-clt">ACID</span>
              <span class="mode-freela">24/7</span>
            </span>
          </div>

          <div class="flex flex-col items-center">
            {
              heroPipelineStages.map((stage, idx) => {
                const icon = getTechIconByKey(stage.iconKey);
                return (
                  <>
                    <div class="w-full rounded-xl border border-gray-200 dark:border-slate-800 bg-gray-50/90 dark:bg-[#0B0F17]/90 px-4 py-3 transition-colors duration-300 hover:bg-white dark:hover:bg-slate-900 hover:border-gray-300 dark:hover:border-[var(--accent-color)]/60">
                      <div class="flex items-center justify-between gap-2">
                        <span
                          class="text-[11px] font-mono font-semibold"
                          style="color: var(--accent-color)"
                        >
                          <span class="mode-clt">{stage.step} · <BiText pt={stage.cltTagPt} en={stage.cltTagEn} /></span>
                          <span class="mode-freela">{stage.step} · <BiText pt={stage.freelaTagPt} en={stage.freelaTagEn} /></span>
                        </span>
                        <span class="h-1.5 w-1.5 rounded-full bg-gray-300 dark:bg-slate-700" />
                      </div>
                      <div class="mt-1.5 flex items-center gap-2">
                        <img
                          src={icon.src}
                          alt=""
                          aria-hidden="true"
                          loading="lazy"
                          decoding="async"
                          class="w-3.5 h-3.5 shrink-0 object-contain"
                        />
                        <p class="mode-clt text-xs font-semibold text-gray-800 dark:text-slate-100 leading-snug">
                          <BiText pt={stage.cltTitlePt} en={stage.cltTitleEn} />
                        </p>
                        <p class="mode-freela text-xs font-semibold text-gray-800 dark:text-slate-100 leading-snug">
                          <BiText pt={stage.freelaTitlePt} en={stage.freelaTitleEn} />
                        </p>
                      </div>
                    </div>

                    {idx < heroPipelineStages.length - 1 && (
                      <svg
                        width="24"
                        height="22"
                        viewBox="0 0 24 22"
                        fill="none"
                        aria-hidden="true"
                        class="my-0.5 overflow-visible"
                      >
                        <line
                          x1="12"
                          y1="0"
                          x2="12"
                          y2="17"
                          stroke="var(--accent-color)"
                          stroke-width="2"
                          stroke-dasharray="4 4"
                          class="pipeline-flow-stroke"
                        />
                        <circle
                          cx="12"
                          cy="2"
                          r="2.4"
                          fill="var(--accent-color)"
                          class="pipeline-pulse-dot"
                          style={`animation-delay: ${idx * 350}ms;`}
                        />
                        <path
                          d="M8.5 13.5L12 18L15.5 13.5"
                          stroke="var(--accent-color)"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </>
                );
              })
            }
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div
    class="px-8 pb-8 pt-4 sm:px-12 sm:pb-12 md:px-20 lg:px-24 md:pb-14 flex gap-x-4 sm:gap-x-6 md:gap-x-8 text-gray-700 dark:text-slate-400 animate-fade-in animation-delay-600"
  >
    {
      siteConfig.social?.email && (
        <a
          href={`mailto:${siteConfig.social.email}`}
          aria-label="Email"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.linkedin && (
        <a
          href={siteConfig.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </>
          </svg>
        </a>
      )
    }
    {
      siteConfig.social?.whatsapp && (
        <a
          href={siteConfig.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="transition-colors duration-300 hover:text-[var(--accent-color)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
