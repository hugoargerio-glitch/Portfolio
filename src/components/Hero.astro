<script is:inline>
  (() => {
    const buttons = document.querySelectorAll("[data-mode-btn]");
    const modeDock = document.querySelector("[data-mode-dock]");
    const pipelineAside = document.querySelector("[data-pipeline-aside]");

    const syncPressed = (mode) => {
      buttons.forEach((btn) =>
        btn.setAttribute("aria-pressed", String(btn.getAttribute("data-mode-btn") === mode))
      );
    };

    const syncHeroAria = () => {
      const isEn = document.documentElement.dataset.lang === "en";
      if (modeDock) {
        modeDock.setAttribute(
          "aria-label",
          isEn
            ? "Select portfolio view mode"
            : "Selecionar modo de visualização do portfólio"
        );
      }
      if (pipelineAside) {
        pipelineAside.setAttribute(
          "aria-label",
          isEn ? "Data pipeline architecture" : "Arquitetura de pipeline de dados"
        );
      }
    };

    syncPressed(document.documentElement.dataset.mode === "freela" ? "freela" : "clt");
    syncHeroAria();
    window.addEventListener("portfolio:langchange", syncHeroAria);

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.getAttribute("data-mode-btn") === "freela" ? "freela" : "clt";
        document.documentElement.dataset.mode = mode;
        syncPressed(mode);
        if (typeof window.__syncPortfolioMeta === "function") {
          window.__syncPortfolioMeta();
        }
        const url = new URL(window.location.href);
        url.searchParams.set("modo", mode);
        window.history.replaceState({}, "", url);
      });
    });
  })();
</script>

