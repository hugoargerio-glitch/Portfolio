---
import { freelaConfig } from "../config";

const packages = freelaConfig.packages ?? [];

function getPackageContactHref(packageName: string): string {
  const baseWhatsapp = freelaConfig.social.whatsapp;
  if (!baseWhatsapp) {
    return freelaConfig.cta.href;
  }
  const message = `Olá Hugo, vim pelo seu portfólio e tenho interesse no ${packageName}. Gostaria de solicitar um diagnóstico técnico.`;
  return `${baseWhatsapp}?text=${encodeURIComponent(message)}`;
}
---

{
  packages.length > 0 && (
    <section
      id="packages"
      class="mode-freela p-8 sm:p-12 md:p-16 lg:p-24"
    >
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4 space-y-4">
            <div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
                Pacotes B2B
              </h2>
              <div
                class="w-[75px] h-[5px] mt-2 rounded-full transition-colors duration-300"
                style="background-color: var(--accent-color)"
              />
            </div>
            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
              Escopo fechado, prazo claro e entrega containerizada em Docker
              Compose para eliminar trabalho manual e reduzir riscos operacionais.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {packages.map((pkg, index) => (
                <article class="p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-lg hover:border-gray-300">
                  <div class="space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span
                        class="text-sm font-mono font-semibold"
                        style="color: var(--accent-color)"
                      >
                        0{index + 1}
                      </span>
                      <span
                        class="inline-flex items-center px-3 py-1 rounded-full text-xs sm:text-sm font-medium border"
                        style="color: var(--accent-color); border-color: color-mix(in srgb, var(--accent-color) 35%, white); background-color: color-mix(in srgb, var(--accent-color) 8%, white);"
                      >
                        Prazo: {pkg.sla}
                      </span>
                    </div>

                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900">
                      {pkg.name}
                    </h3>

                    <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
                      {pkg.painSolved}
                    </p>

                    <ul class="space-y-2 pt-1">
                      {pkg.deliverables.map((item) => (
                        <li class="flex items-start text-sm sm:text-base text-gray-600">
                          <span
                            class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 shrink-0"
                            style="background-color: var(--accent-color)"
                          />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="pt-4 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                      <span class="text-xs sm:text-sm font-mono text-gray-500">
                        {pkg.proofAnchor}
                      </span>
                      <a
                        href={getPackageContactHref(pkg.name)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-sm sm:text-base font-semibold transition-opacity hover:opacity-80"
                        style="color: var(--accent-color)"
                      >
                        Solicitar este pacote
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M5 12l14 0" />
                          <path d="M13 18l6 -6" />
                          <path d="M13 6l6 6" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
