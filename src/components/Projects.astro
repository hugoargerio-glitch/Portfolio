      { iconKey: "airflow", name: "Apache Airflow", role: "DAGs diárias & controle de watermark" },
      { iconKey: "pyspark", name: "PySpark", role: "Transformação distribuída StructType" },
      { iconKey: "databricks", name: "Databricks", role: "Camadas Medallion & Delta MERGE" },
      { iconKey: "snowflake", name: "Snowflake", role: "Star Schema Kimball com RBAC" },
      { iconKey: "python", name: "Python 3.12", role: "Contratos Pydantic V2 & CQR LightGBM" },
    ],
    freela: [
      { iconKey: "airflow", name: "Apache Airflow", role: "Atualização diária antes do expediente" },
      { iconKey: "pyspark", name: "PySpark", role: "Limpeza rápida de séries financeiras" },
      { iconKey: "databricks", name: "Databricks", role: "Base unificada sem registros duplicados" },
      { iconKey: "snowflake", name: "Snowflake", role: "Tabelas otimizadas para Power BI" },
      { iconKey: "python", name: "Python 3.12", role: "Projeções cambiais com 95% confiança" },
    ],
  },
  "B2B-Price-Market-Monitor": {
    clt: [
      { iconKey: "python", name: "Python 3.12", role: "Edge CDC, Dual-Hash & Outbox retry" },
      { iconKey: "sqlite", name: "SQLite 3 WAL", role: "B-Tree ~0,05 ms concorrente local" },
      { iconKey: "docker", name: "Docker", role: "Container leve (~35 MB RAM)" },
      { iconKey: "linux", name: "Linux", role: "Daemon nativo contínuo 24/7" },
    ],
    freela: [
      { iconKey: "python", name: "Python 3.12", role: "Alertas limpos no Slack & Discord" },
      { iconKey: "sqlite", name: "SQLite 3 WAL", role: "Zero custo de banco gerenciado" },
      { iconKey: "docker", name: "Docker", role: "Instalação simples sem SaaS em dólar" },
      { iconKey: "linux", name: "Linux", role: "Monitoramento estável 24/7 em VPS" },
    ],
  },
};

const PROJECT_FLOWS: Record<string, Record<ProfileMode, FlowStage[]>> = {
  "comex-data-engine-v2": {
    clt: [
      { label: "Fontes", detail: "BACEN PTAX · MDIC · SWIFT camt.053" },
      { label: "Validação / Contrato", detail: "ODCS v3.2.0 · Pydantic V2 Anti-Float" },
      { label: "Engine / Storage", detail: "MongoDB 7 · PG16 ACID · HITL" },
      { label: "Saída", detail: "Parquet Hive · DuckDB · FastAPI" },
    ],
    freela: [
      { label: "Fontes", detail: "Faturas · Câmbio BACEN · Bancos" },
      { label: "Guardião Anti-Erro", detail: "Trava Matemática & Quarentena" },
      { label: "Livro Caixa", detail: "Cascata Fiscal + Partidas Dobradas" },
      { label: "Saída", detail: "Landed Cost & Margem Auditada" },
    ],
  },
  "MacroFlow-Lakehouse": {
    clt: [
      { label: "Fontes", detail: "BACEN SGS (Selic/IPCA) · YFinance" },
      { label: "Validação / Contrato", detail: "Airflow Edge · Pydantic V2 · StructType" },
      { label: "Engine / Storage", detail: "Databricks Medallion · Delta MERGE" },
      { label: "Saída", detail: "Snowflake Kimball · LightGBM CQR" },
    ],
    freela: [
      { label: "Fontes", detail: "Indicadores Oficiais & Cotações" },
      { label: "Guardião", detail: "Checagem Automática na Entrada" },
      { label: "Base Única", detail: "Atualização Diária Sem Duplicatas" },
      { label: "Saída", detail: "Power BI Diário & Previsão Cambial" },
    ],
  },
  "B2B-Price-Market-Monitor": {
    clt: [
      { label: "Fontes", detail: "Edge Collectors · HTTP / JSON" },
      { label: "Validação / Contrato", detail: "ODCS v3.2.0 · DECIMAL · Circuit Breaker" },
      { label: "Engine / Storage", detail: "Dual-Hash SHA-256 · SQLite WAL" },
      { label: "Saída", detail: "Transactional Outbox · Discord / Slack" },
    ],
