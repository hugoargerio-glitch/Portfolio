      { iconKey: "fastapi", name: "FastAPI", role: "API REST & fila de quarentena HITL" },
      { iconKey: "postgresql", name: "PostgreSQL 16", role: "Partidas dobradas & triggers PL/pgSQL" },
      { iconKey: "mongodb", name: "MongoDB 7", role: "Ingestão raw camt.053 & documentos" },
      { iconKey: "duckdb", name: "DuckDB", role: "Queries analíticas sobre Parquet Hive" },
      { iconKey: "docker", name: "Docker", role: "Stack tri-store isolado em Compose" },
