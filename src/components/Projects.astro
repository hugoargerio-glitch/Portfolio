      { iconKey: "postgresql", name: "PostgreSQL 16", role: "Livro-razão auditável centavo a centavo" },
      { iconKey: "mongodb", name: "MongoDB 7", role: "Histórico bruto rastreável de faturas" },
      { iconKey: "duckdb", name: "DuckDB", role: "Relatórios de Landed Cost instantâneos" },
      { iconKey: "docker", name: "Docker", role: "Deploy enxuto em servidor único" },
    ],
  },
