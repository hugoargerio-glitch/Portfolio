---
import { profileEntries, type ProfileMode } from "../config";
import { getTechIconByKey, type TechIconKey } from "../utils/techIcons";
import TechBadge from "./TechBadge.astro";
import TerminalDemo from "./TerminalDemo.astro";

interface FlowStage {
  label: string;
  detail: string;
}

interface StackCardDef {
  iconKey: TechIconKey;
  name: string;
  role: string;
}

const PROJECT_STACK_CARDS: Record<string, Record<ProfileMode, StackCardDef[]>> = {
