---
import { navItems } from "../config";
---

<header
  id="header"
  data-scrolled="false"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav
    aria-label="Navegação principal"
    class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex items-center justify-end md:justify-between gap-4"
  >
    <span class="hidden md:block w-10 shrink-0" aria-hidden="true"></span>
    <ul class="hidden md:flex items-center gap-8 justify-center">
      {
        navItems.map((item) => (
          <li class={item.modeClass}>
            <a
              href={item.href}
              class="whitespace-nowrap text-gray-700 hover:text-black dark:text-slate-300 dark:hover:text-slate-100 transition-colors font-medium"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button
      type="button"
      data-theme-toggle
      aria-label="Alternar tema claro e escuro"
      aria-pressed="false"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gray-200/90 bg-white/85 text-gray-700 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-[var(--accent-color)] hover:text-[var(--accent-color)] dark:border-slate-800 dark:bg-[#111827]/90 dark:text-slate-200 dark:hover:border-[var(--accent-color)] dark:hover:text-[var(--accent-color)] cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-color)]"
    >
      <!-- Ícone Lua (visível no Light Mode) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="w-[18px] h-[18px] dark:hidden"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
      </svg>
      <!-- Ícone Sol (visível no Dark Mode) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="w-[18px] h-[18px] hidden dark:block"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
        <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
      </svg>
    </button>
  </nav>
</header>

<style>
  @media (min-width: 768px) {
    #header[data-scrolled="true"] {
      background-color: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(229, 231, 235, 0.7);
    }

    :global(html.dark) #header[data-scrolled="true"] {
      background-color: rgba(11, 15, 23, 0.8);
      border-bottom-color: rgba(30, 41, 59, 0.85);
    }
  }
</style>

<script is:inline>
  (() => {
    const header = document.getElementById("header");
    const themeBtn = document.querySelector("[data-theme-toggle]");

    const syncScroll = () => {
      if (header) {
        header.setAttribute("data-scrolled", String(window.scrollY > 100));
      }
    };

    const syncThemeAria = (isDark) => {
      if (!themeBtn) return;
      themeBtn.setAttribute("aria-pressed", String(isDark));
      themeBtn.setAttribute(
        "aria-label",
        isDark ? "Ativar modo claro" : "Ativar modo escuro"
      );
    };

    syncScroll();
    syncThemeAria(document.documentElement.classList.contains("dark"));

    window.addEventListener("scroll", syncScroll, { passive: true });
    themeBtn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      syncThemeAria(isDark);
    });
  })();
</script>
